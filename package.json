{
  "name": "zhangmensha",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "掌门杀 · 修真门派掌门路主题身份竞技卡牌游戏（三国杀机制 + 修真世界观，构建为单 HTML）",
  "scripts": {
    "dev": "node scripts/dev.mjs cdn",
    "dev:bundled": "node scripts/dev.mjs bundled",
    "build": "npm run build:cdn && npm run build:bundled",
    "build:cdn": "node scripts/build.mjs cdn",
    "build:bundled": "node scripts/build.mjs bundled",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "smoke:cards": "node scripts/smoke-cards.mjs",
    "smoke:roster": "node scripts/smoke-roster.mjs",
    "smoke:roles": "node scripts/smoke-roles.mjs",
    "smoke:contract": "node scripts/smoke-contract.mjs",
    "smoke:wudao": "node scripts/smoke-wudao.mjs",
    "smoke:net": "node scripts/smoke-net.mjs",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "stage:release": "node scripts/stage-release.mjs",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "peerjs": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.8",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
